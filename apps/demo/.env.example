# Copy to .env (gitignored) and fill in. `pnpm --filter demo config` writes public/sdk-config.json from it.

# e.g. https://<your-ce-host>/prweb
PEGA_SERVER_URL=
# Client ID of the OAuth 2.0 client registration (public client, Authorization Code + PKCE recommended)
PEGA_MASHUP_CLIENT_ID=
# Leave empty to use the Pega login popup. Only for password/custom auth testing:
PEGA_MASHUP_USER_IDENTIFIER=
PEGA_MASHUP_PASSWORD_BASE64=
# Optional: application alias, and the case type class to create (e.g. ORG-App-Work-MyCase)
PEGA_APP_ALIAS=
PEGA_CASE_TYPE=
